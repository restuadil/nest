generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  STORE_ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum StoreStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
}

enum AddressLabel {
  HOME
  OFFICE
}

model User {
  id                  String     @id @default(uuid()) 
  email               String     @unique
  username            String     @unique
  password            String
  roles               UserRole[] @default([CUSTOMER])
  status              UserStatus @default(INACTIVE)
  activation_code     String?
  activationExpiresAt DateTime?
  fullName            String?
  phone               String?
  avatar              String?

  // timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations

  //mapping
  @@map("users")
}