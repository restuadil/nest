generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  BANNDED
  ACTIVE
  INACTIVE
  SUSSPENDED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  username            String     @unique
  password            String
  roles               UserRole[] @default([USER])
  status              UserStatus @default(INACTIVE)
  activation_code     String?
  activationExpiresAt DateTime?
  fullName            String?
  phone               String?
  avatar              String?

  // timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //mapping
  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
